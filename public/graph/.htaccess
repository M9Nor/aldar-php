# Uploaded media only: never serve or execute scripts from this tree.
<FilesMatch "\.(php[0-9]?|phtml|phar|pht)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
